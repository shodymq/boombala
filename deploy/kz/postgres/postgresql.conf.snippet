# PostgreSQL for Boom Bala: reachable from the inside only. Appended to postgresql.conf (or placed in conf.d/).
# One-host phase: loopback only. For a separate database host use its PRIVATE address here and a private network between
# the two hosts; never a public address.
listen_addresses = '127.0.0.1'
port = 5432
password_encryption = scram-sha-256
ssl = on
log_connections = on
log_disconnections = on
log_min_duration_statement = 500
log_line_prefix = '%m [%p] %u@%d '
# Never log statements' parameters: they hold names and phone numbers.
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_statement = 'none'
# The application roles carry their own timeouts (scripts/db-roles.ts); this is the ceiling for everyone else.
idle_in_transaction_session_timeout = '60s'
