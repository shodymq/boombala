[Unit]
Description=Boom Bala staff application (admin) - VPN only
After=network-online.target postgresql.service wg-quick@wg0.service
Wants=network-online.target

[Service]
User=bbadmin
Group=bbadmin
WorkingDirectory=/opt/boombala/platform
EnvironmentFile=/etc/boombala/admin.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p @ADMIN_PORT@ -H 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/opt/boombala/platform/.next/cache
MemoryMax=1G

[Install]
WantedBy=multi-user.target
