[Unit]
Description=Boom Bala one-way Google Sheets booking sync
After=network-online.target postgresql.service bb-admin.service
Wants=network-online.target

[Service]
Type=oneshot
User=bbadmin
Group=bbadmin
WorkingDirectory=/opt/boombala/platform
EnvironmentFile=/etc/boombala/admin.env
EnvironmentFile=/etc/boombala/sheets-sync.env
Environment=NODE_ENV=production
UMask=0077
ExecStart=/usr/bin/node --conditions=react-server --no-warnings scripts/sheets-live-sync.ts --scheduled
TimeoutStartSec=55
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
