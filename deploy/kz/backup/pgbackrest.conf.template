# pgBackRest: encrypted backups that live OUTSIDE this server. Two independent copies in two places, both in Kazakhstan.
# Rendered by render.sh; the passphrase and the access keys stay as markers and are filled on the server by hand (file mode 0640, group postgres).
[global]
# Copy 1: S3-compatible object storage of ANOTHER provider/data centre in Kazakhstan.
repo1-type=s3
repo1-s3-endpoint=@BACKUP_S3_ENDPOINT@
repo1-s3-bucket=@BACKUP_S3_BUCKET@
repo1-s3-region=@BACKUP_S3_REGION@
repo1-s3-key=@BACKUP_S3_ACCESS_KEY@
repo1-s3-key-secret=@BACKUP_S3_SECRET_KEY@
repo1-path=/boombala
repo1-retention-full=4
repo1-retention-diff=7
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=@BACKUP_CIPHER_PASSWORD@

# Copy 2: a second host (another data centre in Kazakhstan) over SFTP.
repo2-type=sftp
repo2-sftp-host=@BACKUP_SFTP_HOST@
repo2-sftp-host-user=pgbackrest
repo2-sftp-private-key-file=/etc/pgbackrest/sftp_key
repo2-path=/srv/backups/boombala
repo2-retention-full=4
repo2-retention-diff=7
repo2-cipher-type=aes-256-cbc
repo2-cipher-pass=@BACKUP_CIPHER_PASSWORD@

compress-type=zst
start-fast=y
archive-async=y
log-level-file=info

[boombala]
pg1-path=/var/lib/postgresql/16/main
pg1-socket-path=/var/run/postgresql
