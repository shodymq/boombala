# Environment of the PUBLIC SITE on Vercel (Production). Not a file on the server: set these in the Vercel project.
# The site holds NO database credentials, NO second-factor key, NO admin address and NO knowledge of the admin domain.
PLATFORM_URL=https://@API_HOST@
PLATFORM_INTAKE_TOKEN=@PLATFORM_INTAKE_TOKEN@
REVALIDATE_TOKEN=@REVALIDATE_TOKEN@

# Everything below keeps today's behaviour until the owner decides otherwise.
LEAD_PIPELINE=telegram-only
CONSENT_FORM_ENABLED=0
NEXT_PUBLIC_BOOKING_CALENDAR=0
NEXT_PUBLIC_NEWS=0
