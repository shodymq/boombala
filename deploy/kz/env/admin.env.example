# /etc/boombala/admin.env  (mode 0600, owner bbadmin). The STAFF application. Placeholders are words between two at-signs; generate secrets with the commands shown.
PLATFORM_PROFILE=kz-production
PLATFORM_ROLE=admin
PLATFORM_HTTPS=1
ALLOWED_HOSTS=@ADMIN_HOST@
ADMIN_ALLOWED_CIDRS=@WG_SUBNET@,127.0.0.1/32

DATABASE_URL=postgres://bb_admin:@DB_ADMIN_PASSWORD@@127.0.0.1:5432/@DB_NAME@
DATABASE_POOL_MAX=5

# Second factor is mandatory. Key: openssl rand -base64 32   (lose it and nobody's authenticator works: back it up offline, apart from database backups)
MFA_MODE=required
MFA_ENC_KEY=@MFA_ENC_KEY@

# The retry worker (systemd timer on loopback) and the call to the public site that refreshes cached news.
CRON_SECRET=@CRON_SECRET@
REVALIDATE_TOKEN=@REVALIDATE_TOKEN@
SITE_REVALIDATE_URL=https://@PUBLIC_SITE_HOST@

# Notifications leave the server from HERE only. "minimal" = no name and no phone in the message.
TELEGRAM_BOT_TOKEN=@TELEGRAM_BOT_TOKEN@
TELEGRAM_CHAT_ID=@TELEGRAM_CHAT_ID@
TELEGRAM_NOTIFY_LEVEL=minimal

# NOT here, on purpose (the application refuses to start with them): PLATFORM_INTAKE_TOKEN, PLATFORM_IP_PEPPER.
