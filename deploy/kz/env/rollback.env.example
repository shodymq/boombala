# Environment of the ROLLBACK deployment: the only place DNS may be pointed back to if the Kazakhstan server fails.
# It is a SEPARATE hosting project/deployment built from the release code, NOT the legacy production project.
# Pages are served, the forms always answer "unavailable" (the visitor still has the phone and WhatsApp on the page).
# Nothing here can carry a name or a phone anywhere: there are NO Telegram credentials and NO platform address in this project.
# (The application reports any such variable as a problem, and the forms refuse in any case: src/lib/site-profile.ts.)
SITE_PROFILE=rollback-safe
NEXT_PUBLIC_SITE_URL=https://@PUBLIC_SITE_HOST@
CONSENT_FORM_ENABLED=0
NEXT_PUBLIC_BOOKING_CALENDAR=0
NEXT_PUBLIC_NEWS=0
