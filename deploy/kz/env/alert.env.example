# /etc/boombala/alert.env  (mode 0600, owner root). The OPERATIONS alert channel: a failed backup or a failed backup check.
# A separate bot and a separate channel from the enquiry notifications. The message carries the unit name and the host, never personal data.
ALERT_BOT_TOKEN=@ALERT_BOT_TOKEN@
ALERT_CHAT_ID=@ALERT_CHAT_ID@
