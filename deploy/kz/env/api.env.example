# /etc/boombala/api.env  (mode 0600, owner bbapi). The API behind the site: loopback only, no public listener, no public name.
# Placeholders are words between two at-signs.
PLATFORM_PROFILE=kz-production
PLATFORM_ROLE=api
PLATFORM_HTTPS=1
ALLOWED_HOSTS=127.0.0.1:@API_PORT@

DATABASE_URL=postgres://bb_api:@DB_API_PASSWORD@@127.0.0.1:5432/@DB_NAME@
DATABASE_POOL_MAX=5

# Shared with the public site (it calls this API with it, on loopback). Generate: openssl rand -base64 32
PLATFORM_INTAKE_TOKEN=@PLATFORM_INTAKE_TOKEN@
# Hashes visitors' addresses in the consent history. Generate: openssl rand -base64 32
PLATFORM_IP_PEPPER=@PLATFORM_IP_PEPPER@

# Personal data is accepted only when this is 1, and it is 1 only after the owner's written decision (see docs).
PII_INTAKE_ENABLED=0

# NOT here, on purpose (the application refuses to start with them): MFA_ENC_KEY, CRON_SECRET, REVALIDATE_TOKEN,
# SITE_REVALIDATE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, ADMIN_ALLOWED_CIDRS.
