# /etc/boombala/site.env  (mode 0600, owner bbsite). The PUBLIC SITE, running on the Kazakhstan server. Placeholders are words between two at-signs.
# The site holds NO database credentials, NO second-factor key and NO admin address. It reaches the API on loopback only.
PLATFORM_URL=http://127.0.0.1:@API_PORT@
PLATFORM_INTAKE_TOKEN=@PLATFORM_INTAKE_TOKEN@
REVALIDATE_TOKEN=@REVALIDATE_TOKEN@

NEXT_PUBLIC_SITE_URL=https://@PUBLIC_SITE_HOST@

# Everything below keeps today's behaviour until the owner decides otherwise.
LEAD_PIPELINE=telegram-only
CONSENT_FORM_ENABLED=0
NEXT_PUBLIC_BOOKING_CALENDAR=0
NEXT_PUBLIC_NEWS=0

# Legacy direct notification of an enquiry (LEAD_PIPELINE=telegram-only). It goes away when the pipeline is switched to "strict":
# from then on notifications leave the server from the staff application only.
TELEGRAM_BOT_TOKEN=@TELEGRAM_BOT_TOKEN@
TELEGRAM_CHAT_ID=@TELEGRAM_CHAT_ID@
