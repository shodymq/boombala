# /etc/boombala/site.env  (mode 0600, owner bbsite). The PUBLIC SITE, running on the Kazakhstan server. Placeholders are words between two at-signs.
# The site holds NO database credentials, NO second-factor key and NO admin address. It reaches the API on loopback only.
PLATFORM_URL=http://127.0.0.1:@API_PORT@
PLATFORM_INTAKE_TOKEN=@PLATFORM_INTAKE_TOKEN@
REVALIDATE_TOKEN=@REVALIDATE_TOKEN@

NEXT_PUBLIC_SITE_URL=https://@PUBLIC_SITE_HOST@

# FAIL CLOSED. With this profile the site accepts no enquiry unless the configuration is safe (see src/lib/site-profile.ts):
#   - LEAD_PIPELINE must be "strict": an enquiry is saved in the platform or refused, it never goes to Telegram from the site;
#   - the site holds NO Telegram credentials (notifications leave from the staff application, "minimal": no name, no phone);
#   - the platform is on loopback. Until the owner enables intake (PII_INTAKE_ENABLED=1 in api.env) the form answers "unavailable".
SITE_PROFILE=kz-production
LEAD_PIPELINE=strict
CONSENT_FORM_ENABLED=0
NEXT_PUBLIC_BOOKING_CALENDAR=0
NEXT_PUBLIC_NEWS=0
