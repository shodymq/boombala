# ADMIN: <admin domain>. Reachable ONLY through the VPN: it listens on the WireGuard address, never on a public one,
# the firewall has no rule for it on the public interface, nginx itself denies every other source, and the application
# checks the source address once more. There is no port 80 and no public DNS record for this name.
server {
  listen @WG_SERVER_ADDR@:443 ssl default_server;
  ssl_reject_handshake on;
}

server {
  listen @WG_SERVER_ADDR@:443 ssl;
  http2 on;
  server_name @ADMIN_HOST@;
  include /etc/nginx/boombala/bb-tls.conf;
  ssl_certificate     /etc/ssl/boombala/admin.fullchain.pem;
  ssl_certificate_key /etc/ssl/boombala/admin.key;

  allow @WG_SUBNET@;
  deny all;

  server_tokens off;
  client_max_body_size 6m;   # news pictures; the application enforces its own limits
  client_header_timeout 10s;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  add_header Cache-Control "no-store" always;

  include /etc/nginx/boombala/bb-proxy.conf;

  # The retry worker is called by the local timer on loopback, never through nginx.
  location /api/cron/ { return 404; }
  # The staff application has no public intake and no public reads.
  location /api/intake/ { return 404; }
  location /api/public/ { return 404; }

  location / {
    proxy_pass http://127.0.0.1:@ADMIN_PORT@;
  }
}
