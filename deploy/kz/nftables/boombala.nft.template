#!/usr/sbin/nft -f
# Firewall of the Kazakhstan VPS. Default: drop. Only three things are reachable:
#   - UDP @WG_PORT@                      WireGuard (the door for employees)
#   - TCP 80/443 on the PUBLIC interface  the public API (nginx binds the admin to the VPN address, not to this one)
#   - TCP 22/443 and UDP 53 on wg0        SSH, the admin and the VPN's own DNS, only from VPN addresses
# PostgreSQL (5432) and the two application ports (@ADMIN_PORT@, @API_PORT@) are not mentioned: dropped from everywhere except loopback.
flush ruleset

table inet bb {
  set vpn_net {
    type ipv4_addr
    flags interval
    elements = { @WG_SUBNET@ }
  }

  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    ip protocol icmp icmp type echo-request limit rate 5/second accept
    ip6 nexthdr ipv6-icmp accept

    udp dport @WG_PORT@ accept

    iifname "@PUBLIC_IF@" tcp dport { 80, 443 } accept

    iifname "wg0" ip saddr @vpn_net tcp dport { 22, 443 } accept
    iifname "wg0" ip saddr @vpn_net udp dport 53 accept

    limit rate 5/minute log prefix "bb-drop " counter drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
