# Isolated CRM staging. Copy to staging.env (git-ignored) and fill the paths. No production values belong here.
# Every value below must stay on 127.0.0.1 or the operator's own tunnel; nothing is exposed through nginx or DNS.

STAGING_ROOT=$HOME/boombala-staging          # all state: data, logs, backups, pid files
BACKEND_DIR=$HOME/src/boombala-app-staging/backend   # BoomBalaApp worktree at the pinned SHA
PLATFORM_DIR=$HOME/src/boombala-platform-staging     # boombala feature worktree at the pinned SHA
BACKEND_SHA=6245ddcb97f16b1ff6eb1ebd0f83f2437fa5e986
PLATFORM_SHA=REPLACE-WITH-REVIEWED-HEAD        # full SHA of the reviewed feature-branch commit

# Isolated PostgreSQL cluster for staging only (its own data directory and port; the production cluster is not used).
STAGING_PG_BIN=/usr/lib/postgresql/17/bin
STAGING_PG_PORT=55433
STAGING_PG_USER=staging

STAGING_FASTAPI_PORT=8100
STAGING_PLATFORM_PORT=3400

# Ports that belong to the live services. guard.sh refuses to start if staging would use one of them.
PROTECTED_PORTS="3000 3100 3101 5432 80 443"

# Database names; guard.sh refuses any name that contains the production markers below.
STAGING_BACKEND_DB=crm_staging
STAGING_PLATFORM_DB=platform_staging
PRODUCTION_MARKERS="star_kids boombala_prod bb_prod"

# Secrets are NOT stored here. gen-secrets.sh writes them to $STAGING_ROOT/secrets.env with mode 600.
