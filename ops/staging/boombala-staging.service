# systemd --user unit for the isolated CRM staging. The supervisor restarts crashed services; systemd restarts the supervisor.
# Touches only staging processes on 127.0.0.1; never bb-admin, bb-site, bb-api, nginx, DNS or production PostgreSQL.
[Unit]
Description=Boom Bala CRM staging (isolated, 127.0.0.1 only)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/boombala-platform-staging/ops/staging
Environment=STAGING_ENV=%h/boombala-staging/staging.env
ExecStartPre=%h/src/boombala-platform-staging/ops/staging/guard.sh
ExecStart=%h/src/boombala-platform-staging/ops/staging/supervise.sh
ExecStop=%h/src/boombala-platform-staging/ops/staging/down.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
