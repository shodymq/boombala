# Server-only. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Telegram API proxy/mock. Defaults to https://api.telegram.org
TELEGRAM_API_BASE=

# Public
# Optional override. Production builds default to https://boombala.kz
NEXT_PUBLIC_SITE_URL=
# Optional override. Defaults to the confirmed 2GIS link (https://go.2gis.com/6zqEx).
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── CRM pipeline (all OFF by default; do not enable without the owner's decision on lawful data hosting) ──
# FastAPI client settings for the public-site server runtime.
FASTAPI_FEATURES=
FASTAPI_BASE_URL=
FASTAPI_TIMEOUT_MS=
# Set to 1 only after the signed public endpoint and catalog mappings are configured.
UNIFIED_FASTAPI_WEBSITE_LEADS=
UNIFIED_FASTAPI_WEBSITE_SERVICE_ID=
UNIFIED_FASTAPI_WEBSITE_SERVICE_SECRET=
UNIFIED_FASTAPI_BRANCH_ID=
UNIFIED_FASTAPI_PACKAGE_MAP=
UNIFIED_FASTAPI_ROOM_MAP=
UNIFIED_FASTAPI_SLOT_MAP=
UNIFIED_FASTAPI_CONSENT_DOCUMENT_KIND=
UNIFIED_FASTAPI_CONSENT_DOCUMENT_VERSION=
# telegram-only (default, today's behaviour) | dual (platform first, direct Telegram as fallback) | strict (platform only)
LEAD_PIPELINE=
# Platform origin (https, or http://localhost for development) and the shared server-to-server secret
PLATFORM_URL=
PLATFORM_INTAKE_TOKEN=
# 1 enables the QR registration page /consent (needs published visit_rules and personal_data_consent documents)
CONSENT_FORM_ENABLED=
# 1 shows free dates/slots and the price for the chosen date in the lead form (needs the platform; OFF by default)
NEXT_PUBLIC_BOOKING_CALENDAR=
# 1 shows the News and promotions section (/news, sitemap, menu link). Needs the platform. OFF by default.
NEXT_PUBLIC_NEWS=
