# Server-only. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Telegram API proxy/mock. Defaults to https://api.telegram.org
TELEGRAM_API_BASE=

# Public
# Optional override. Production builds default to https://boombala.kz
NEXT_PUBLIC_SITE_URL=
# Optional override. Defaults to the confirmed 2GIS link (https://go.2gis.com/6zqEx).
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── CRM pipeline (all OFF by default; do not enable without the owner's decision on lawful data hosting) ──
# telegram-only (default, today's behaviour) | dual (platform first, direct Telegram as fallback) | strict (platform only)
LEAD_PIPELINE=
# Platform origin (https, or http://localhost for development) and the shared server-to-server secret
PLATFORM_URL=
PLATFORM_INTAKE_TOKEN=
# 1 enables the QR registration page /consent (needs published visit_rules and personal_data_consent documents)
CONSENT_FORM_ENABLED=
