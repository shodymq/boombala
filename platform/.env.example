# Copy to .env.local for development. NEVER commit real values.

# PostgreSQL connection string. For local development: `npm run db:local -- start` prints one.
DATABASE_URL=postgres://postgres@127.0.0.1:54330/boombala_platform

# Set to 1 when the app is served over HTTPS (always in production behind the reverse proxy):
# enables the __Host- session cookie name, Secure cookies, HSTS and upgrade-insecure-requests.
PLATFORM_HTTPS=0
