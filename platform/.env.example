# Copy to .env.local for development. NEVER commit real values.

# PostgreSQL connection string. For local development: `npm run db:local -- start` prints one.
DATABASE_URL=postgres://postgres@127.0.0.1:54330/boombala_platform

# Set to 1 when the app is served over HTTPS (always in production behind the reverse proxy):
# enables the __Host- session cookie name, Secure cookies, HSTS and upgrade-insecure-requests.
PLATFORM_HTTPS=0

# ── Supabase / production (Vercel Environment Variables, Sensitive). See docs/platform/OPERATIONS.md ──
# DATABASE_URL=            Transaction pooler (port 6543)
# MIGRATION_DATABASE_URL=  Direct/session connection, only where migrations are run
# DATABASE_CA_CERT=        PEM of the provider CA (or DATABASE_SSL=no-verify, not recommended)

# ── CRM (all OFF by default) ──
# PII_INTAKE_ENABLED=0     1 only after the decision on lawful hosting of personal data
# PLATFORM_INTAKE_TOKEN=   shared secret with the public site (>= 24 random chars)
# CRON_SECRET=             secret of GET /api/cron/outbox
# PLATFORM_IP_PEPPER=      secret for hashing IP addresses in the consent history
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_LEVEL=full   full (as today) | minimal (no name or phone in Telegram)
# TELEGRAM_API_BASE=           only for local mocks
